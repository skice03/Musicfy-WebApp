@model MusicfyWebApp.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-dark border-secondary shadow p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold" style="color: #1DB954;">Welcome Back</h2>
                    <p class="text-secondary">Log in to your Musicfy account</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-secondary">Email Address</label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary"
                               placeholder="your@email.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-secondary">Password</label>
                        <input asp-for="Password" class="form-control bg-dark text-white border-secondary"
                               placeholder="Enter your password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label text-secondary" asp-for="RememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-musicfy w-100 py-2 fw-bold">Log In</button>

                    <div class="text-center mt-4">
                        <span class="text-secondary">Don't have an account?</span>
                        <a asp-action="Register" class="text-decoration-none" style="color: #1DB954;">Sign up</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
