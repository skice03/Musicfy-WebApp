<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Musicfy</title>
    
    <link rel="icon" type="image/png" href="~/resources/tabicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="~/css/style.css" rel="stylesheet">
        </head>

        <body class="d-flex flex-column min-vh-100">

            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">Musicfy</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Library">Library</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Songs" asp-action="Index">Songs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Artists" asp-action="Index">Artists</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Songs" asp-action="Create">Upload</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Profile">Profile</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <main class="flex-grow-1">
                @RenderBody()
            </main>

            <footer class="mt-5 py-4" style="background-color: #000000; border-top: 1px solid #282828;">
                <div class="container text-center">
                    <p class="mb-2" style="color: #B3B3B3;">&copy; 2026 Musicfy</p>
                </div>
            </footer>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>