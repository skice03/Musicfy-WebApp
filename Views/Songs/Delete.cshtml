@model MusicfyWebApp.Models.Song

@{
    ViewData["Title"] = "Deleting Song";
}

<div class="container mt-4 text-white">
    <h1 class="text-danger">Delete the song</h1>
    <h4 class="mt-3">Are you sure you want to remove this song from your library?</h4>
    <hr class="border-secondary" />
    
    <dl class="row mt-4">
        <dt class="col-sm-3 text-secondary">Title</dt>
        <dd class="col-sm-9 fs-5">@Model.Title</dd>
        
        <dt class="col-sm-3 text-secondary">Length</dt>
        <dd class="col-sm-9">@Model.Length</dd>
    </dl>
    
    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="SongId" />
        <button type="submit" class="btn btn-danger px-4">Yes</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
