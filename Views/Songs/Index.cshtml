@model IEnumerable<MusicfyWebApp.Models.Song>

@{
    ViewData["Title"] = "Songs";
}

<div class="container mt-5 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Songs</h2>
        <div class="d-flex align-items-center gap-3">
            <input type="text" id="searchBox" class="form-control bg-dark text-white border-secondary"
                   placeholder="Search for a song..." style="width: 250px;" />
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-action="Create" class="btn btn-sm btn-success fw-bold" style="background-color: #1DB954; border: none; white-space: nowrap;">+ Upload Song</a>
            }
        </div>
    </div>

    <table class="table table-dark table-hover mt-4 align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Length</th>
                <th>Album</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="songsTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold text-white">@item.Title</td>
                    <td class="text-light">
                        @if (item.Artist != null)
                        {
                            <a asp-controller="Artists" asp-action="Details" asp-route-id="@item.ArtistId"
                               class="text-decoration-none" style="color: #1DB954;">@item.Artist.Name</a>
                        }
                        else
                        {
                            <span>Unknown Artist</span>
                        }
                    </td>
                    <td>@item.Length</td>
                    <td>
                        @if (item.Album != null)
                        {
                            <a asp-controller="Albums" asp-action="Details" asp-route-id="@item.AlbumId"
                               class="text-decoration-none" style="color: #1DB954;">@item.Album.Title</a>
                        }
                        else
                        {
                            <span style="color: #1DB954;">Single</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.AudioUrl))
                        {
                            <button class="btn btn-sm btn-outline-success me-1 btn-play-song"
                                    data-audio-url="@item.AudioUrl"
                                    data-song-title="@item.Title"
                                    data-song-artist="@(item.Artist?.Name ?? "Unknown")">
                                ▶ Play
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" disabled>No Audio</button>
                        }
                        @{
                            var currentUserId = ViewBag.CurrentUserId as string;
                            var canModify = User.IsInRole("Admin") || (item.UserId != null && item.UserId == currentUserId);
                        }
                        @if (canModify)
                        {
                            <a asp-action="Edit" asp-route-id="@item.SongId"
                               class="text-secondary text-decoration-none me-1 small">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.SongId"
                               class="text-danger text-decoration-none small">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mini Audio Player Bar -->
<div id="audioPlayerBar" class="fixed-bottom d-none" style="background: linear-gradient(180deg, #181818 0%, #000 100%); border-top: 1px solid #282828; padding: 10px 0;">
    <div class="container d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <span id="playerSongTitle" class="fw-bold text-white d-block" style="font-size: 0.9rem;">Song Title</span>
                <span id="playerSongArtist" class="text-secondary" style="font-size: 0.75rem;">Artist</span>
            </div>
        </div>
        <div class="flex-grow-1 mx-4">
            <audio id="audioPlayer" class="w-100" style="height: 32px; filter: sepia(20%) saturate(70%) grayscale(1) contrast(99%) invert(12%);"></audio>
        </div>
        <button id="closePlayer" class="btn btn-sm btn-outline-secondary" style="border-radius: 50px;">✕</button>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            
        var originalTableContent = $("#songsTableBody").html();

        // AJAX Search
        $("#searchBox").on("keyup", function () {
            var term = $(this).val().trim();

            if (term === "") {
                $("#songsTableBody").html(originalTableContent);
                rebindPlayButtons();
                return;
            }

            $.ajax({
                url: '/Songs/Search',
                type: 'GET',
                data: { searchTerm: term },
                success: function (songs) {
                    $("#songsTableBody").empty();
                        
                    if (songs.length === 0) {
                        $("#songsTableBody").append('<tr><td colspan="5" class="text-center text-muted py-4">Unable to find any song.</td></tr>');
                        return;
                    }
                        
                    $.each(songs, function (index, song) {
                        var albumDisplay = song.album ? song.album.title : "Single";
                        var artistDisplay = song.artist ? song.artist.name : "Unknown Artist";
                        var audioUrl = song.audioUrl || "";
                        var playBtn = audioUrl 
                            ? '<button class="btn btn-sm btn-outline-success me-1 btn-play-song" data-audio-url="' + audioUrl + '" data-song-title="' + song.title + '" data-song-artist="' + artistDisplay + '">▶ Play</button>'
                            : '<button class="btn btn-sm btn-outline-secondary me-1" disabled>No Audio</button>';

                        var row = '<tr>' +
                            '<td class="fw-bold text-white">' + song.title + '</td>' +
                            '<td class="text-light">' + artistDisplay + '</td>' +
                            '<td>' + (song.length || '-') + '</td>' +
                            '<td style="color: #1DB954;">' + albumDisplay + '</td>' +
                            '<td>' + playBtn + '</td>' +
                            '</tr>';
                        $("#songsTableBody").append(row);
                    });
                    rebindPlayButtons();
                },
                error: function () {
                    console.log("Found an error while searching.");
                }
            });
        });

        // Audio Player
        function rebindPlayButtons() {
            $(".btn-play-song").off("click").on("click", function () {
                var audioUrl = $(this).data("audio-url");
                var title = $(this).data("song-title");
                var artist = $(this).data("song-artist");
                
                $("#playerSongTitle").text(title);
                $("#playerSongArtist").text(artist);
                
                var player = document.getElementById("audioPlayer");
                player.src = audioUrl;
                player.controls = true;
                player.play();
                
                $("#audioPlayerBar").removeClass("d-none");
            });
        }

        rebindPlayButtons();

        $("#closePlayer").on("click", function () {
            var player = document.getElementById("audioPlayer");
            player.pause();
            player.src = "";
            $("#audioPlayerBar").addClass("d-none");
        });
        });
    </script>
}