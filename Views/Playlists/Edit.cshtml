@model MusicfyWebApp.Models.Playlist
@{
    ViewData["Title"] = "Edit Playlist";
}

<div class="container mt-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">Edit playlist details</h2>

            <form asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="PlaylistId" />
                <input type="hidden" asp-for="ImageUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Playlist Title</label>
                    <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary"
                              rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Cover Image</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Current cover" class="rounded"
                                 style="width: 80px; height: 80px; object-fit: cover;" />
                            <span class="text-secondary small ms-2">Current cover</span>
                        </div>
                    }
                    <input type="file" name="CoverImage" accept="image/*"
                           class="form-control bg-dark text-white border-secondary" />
                    <small class="text-secondary">Leave empty to keep the current cover.</small>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="IsPublic" />
                    <label class="form-check-label text-secondary" asp-for="IsPublic">Public Playlist</label>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary px-4">Update</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Go back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}