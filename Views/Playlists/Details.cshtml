@model MusicfyWebApp.Models.Playlist
@{
    ViewData["Title"] = "Playlist Details";
}

<div class="container mt-4 text-white">
    <h1>Playlist Details</h1>
    <hr class="border-secondary" />
    
    <div class="row mt-4">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="Cover">
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 250px;">
                    <span class="text-white-50">No Cover</span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3 text-secondary">Title</dt>
                <dd class="col-sm-9 fs-5 text-success">@Model.Title</dd>
                
                <dt class="col-sm-3 text-secondary">Descriere</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)
                </dd>

                <dt class="col-sm-3 text-secondary">Status</dt>
                <dd class="col-sm-9">@(Model.IsPublic ? "🌐 Public" : "🔒 Private")</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model?.PlaylistId" class="btn btn-outline-light">Edit</a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to list</a>
            </div>
        </div>
    </div>
</div>