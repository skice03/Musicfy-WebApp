@model IEnumerable<MusicfyWebApp.Models.Playlist>
@{
    ViewData["Title"] = "Playlists";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container mt-5 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Playlists</h2>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-success fw-bold" style="border-radius: 50px; padding: 8px 24px;">+ Create Playlist</a>
        }
    </div>

    <div class="row mt-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                var isOwner = item.UserId == currentUserId;
                var canModify = isOwner || User.IsInRole("Admin");

                <div class="col-md-4 mb-4">
                    <div class="card bg-dark border-secondary h-100 p-0 overflow-hidden shadow-hover" style="transition: 0.3s;">
                        <a asp-action="Details" asp-route-id="@item.PlaylistId" class="text-decoration-none">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top" alt="Cover" style="height: 180px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-secondary" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                                    <span class="text-white-50 fs-1">🎵</span>
                                </div>
                            }
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title" style="color: #1DB954;">@item.Title</h5>
                            <p class="card-text text-secondary mb-1 small">
                                @(string.IsNullOrEmpty(item.Description) ? "No description" : item.Description)
                            </p>
                            <div class="d-flex align-items-center mt-1 mb-2">
                                <span class="badge rounded-pill @(item.IsPublic ? "bg-success" : "bg-secondary") me-2">
                                    @(item.IsPublic ? "🌐 Public" : "🔒 Private")
                                </span>
                                @if (item.User != null && !isOwner)
                                {
                                    <small class="text-secondary">by @item.User.UserName</small>
                                }
                                @if (isOwner)
                                {
                                    <small class="text-secondary">Your playlist</small>
                                }
                            </div>
                            @if (canModify)
                            {
                                <div class="mt-auto pt-3 border-top border-secondary">
                                    <a asp-action="Edit" asp-route-id="@item.PlaylistId"
                                       class="btn btn-sm btn-outline-light me-1">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.PlaylistId"
                                       class="btn btn-sm btn-outline-info me-1">View</a>
                                    <a asp-action="Delete" asp-route-id="@item.PlaylistId"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            }
                            else
                            {
                                <div class="mt-auto pt-3 border-top border-secondary">
                                    <a asp-action="Details" asp-route-id="@item.PlaylistId"
                                       class="btn btn-sm btn-outline-info">View</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <h4 class="text-secondary">No playlists yet</h4>
                <p class="text-secondary">Create your first playlist to get started!</p>
            </div>
        }
    </div>
</div>

<style>
    .shadow-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(29, 185, 84, 0.15) !important;
    }
</style>