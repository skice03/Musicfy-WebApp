@model MusicfyWebApp.Models.Artist

@{
    ViewData["Title"] = "Edit Artist";
}

<div class="container mt-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">Edit artist details</h2>

            <form asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="ArtistId" />
                <input type="hidden" asp-for="ImageUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Artist Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Bio" class="form-label">Biography</label>
                    <textarea asp-for="Bio" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="IsVerified" />
                    <label class="form-check-label text-white d-flex align-items-center" asp-for="IsVerified">
                        Official Verified Artist <i class="bi bi-patch-check-fill text-primary ms-2 fs-5"></i>
                    </label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Artist Photo</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Current photo" class="rounded-circle"
                                 style="width: 80px; height: 80px; object-fit: cover;" />
                            <span class="text-secondary small ms-2">Current photo</span>
                        </div>
                    }
                    <input type="file" name="ImageFile" accept="image/*"
                           class="form-control bg-dark text-white border-secondary" />
                    <small class="text-secondary">Leave empty to keep the current photo.</small>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary px-4">Update</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Go back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
