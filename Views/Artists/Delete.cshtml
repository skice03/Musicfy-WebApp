@model MusicfyWebApp.Models.Artist

@{
    ViewData["Title"] = "Delete Artist";
}

<div class="container mt-4 text-white">
    <h1 class="text-danger">Delete the artist</h1>
    <h4 class="mt-3">Are you sure you want to remove this artist?</h4>
    <hr class="border-secondary" />

    <dl class="row mt-4">
        <dt class="col-sm-3 text-secondary">Name</dt>
        <dd class="col-sm-9 fs-5 fw-bold">@Model.Name</dd>

        <dt class="col-sm-3 text-secondary">Bio</dt>
        <dd class="col-sm-9">@Model.Bio</dd>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <dt class="col-sm-3 text-secondary">Image</dt>
            <dd class="col-sm-9">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded shadow-sm" style="max-height: 100px; object-fit: cover;" />
            </dd>
        }
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="ArtistId" />
        <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
