@model MusicfyWebApp.Models.ViewModels.LibraryViewModel
@{
    ViewData["Title"] = "Library";
}

<div class="container mt-5 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div class="d-flex align-items-center">
            <h2 class="mb-0 me-3">Music Library</h2>
            <span class="text-secondary small">@(Model.Albums.Count() + Model.Playlists.Count()) Items</span>
        </div>
        
        <div>
            <a asp-controller="Albums" asp-action="Index" class="btn btn-sm btn-outline-secondary me-2">Show all albums</a>
            <a asp-controller="Playlists" asp-action="Index" class="btn btn-sm btn-outline-secondary me-4">Show all playlists</a>
            
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Albums" asp-action="Create" class="btn btn-sm btn-success fw-bold me-2">+ Album</a>
            }
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Playlists" asp-action="Create" class="btn btn-sm btn-success fw-bold">+ Playlist</a>
            }
        </div>
    </div>

    @if (!Model.Albums.Any() && !Model.Playlists.Any())
    {
        <div class="text-center py-5">
            <h4 class="text-secondary">Your library is empty</h4>
            <p class="text-secondary">Start by adding albums and creating playlists!</p>
        </div>
    }

    <div class="row">
        @foreach (var album in Model.Albums)
        {
            <div class="col-md-3 mb-4">
                <a asp-controller="Albums" asp-action="Details" asp-route-id="@album.AlbumId" class="text-decoration-none">
                    <div class="card p-3 border-secondary bg-dark h-100 shadow-hover">
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge rounded-pill bg-primary" style="font-size: 0.6rem;">ALBUM</span>
                        </div>
                        @if (!string.IsNullOrEmpty(album.CoverImageUrl))
                        {
                            <img src="@album.CoverImageUrl" class="card-img-top rounded shadow" alt="@album.Title">
                        }
                        else
                        {
                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="aspect-ratio: 1/1;">
                                <span class="fs-1 text-white-50">🎵</span>
                            </div>
                        }
                        <div class="card-body px-0 pb-0 mt-2">
                            <h5 class="card-title mb-1 text-truncate">@album.Title</h5>
                            <p class="card-text text-secondary">@album.ReleaseYear • @(album.Artist?.Name ?? "Unknown")</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        @foreach (var playlist in Model.Playlists)
        {
            <div class="col-md-3 mb-4">
                <a asp-controller="Playlists" asp-action="Details" asp-route-id="@playlist.PlaylistId" class="text-decoration-none">
                    <div class="card p-3 border-secondary bg-dark h-100 shadow-hover">
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge rounded-pill bg-success" style="font-size: 0.6rem;">PLAYLIST</span>
                        </div>
                        @if (!string.IsNullOrEmpty(playlist.ImageUrl))
                        {
                            <img src="@playlist.ImageUrl" class="card-img-top rounded shadow" alt="@playlist.Title">
                        }
                        else
                        {
                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="aspect-ratio: 1/1;">
                                <span class="fs-1 text-white-50">📂</span>
                            </div>
                        }
                        <div class="card-body px-0 pb-0 mt-2">
                            <h5 class="card-title mb-1 text-truncate">@playlist.Title</h5>
                            <p class="card-text text-secondary">@(playlist.IsPublic ? "Public" : "Private")</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .shadow-hover { transition: all 0.2s ease-in-out; border: 1px solid #333; }
    .shadow-hover:hover {
        transform: scale(1.02);
        background-color: #282828 !important;
        border-color: #1DB954 !important;
    }
    .card-img-top { aspect-ratio: 1 / 1; object-fit: cover; }
    .card-title { font-size: 0.9rem; font-weight: 600; color: white; }
    .card-text { font-size: 0.8rem; }
</style>