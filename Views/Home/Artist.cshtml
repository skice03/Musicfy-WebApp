@{
    ViewData["Title"] = "Travis Scott";
}
<div class="container mt-5">
    <div class="row mb-5 align-items-center">
        <div class="col-md-3 text-center mb-4 mb-md-0">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/9/9c/Travis_Scott_February_2016.jpg/960px-Travis_Scott_February_2016.jpg"
                 class="rounded-circle shadow" style="width: 250px; height: 250px; object-fit: cover;"
                 alt="Artist Profile Picture">
        </div>
        <div class="col-md-9">
            <h6 class="text-uppercase mb-2" style="color: #1DB954; font-weight: 600; letter-spacing: 2px;">Verified
                Artist</h6>
                <h1 class="display-3 fw-bold mb-3" style="color: white;">Travis Scott</h1>
                <p class="lead" style="color: #B3B3B3;">Travis Scott (born Jacques Webster II) helped define 2010s rap by
                    blending surreal trap with massive pop appeal. Raised in Houston, he started as a producer for Kanye
                    West before launching his own solo career. With a gothic-edged sound, Scott became known as a visionary
                    curator, pulling A-list collaborators across genres to create psychedelic, avant-garde blockbuster
                    albums like Rodeo, ASTROWORLD, and 2023’s Utopia.</p>
                    <div class="mt-4">
                        <button class="btn btn-musicfy px-4 py-2 me-2">Play</button>
                        <button class="btn btn-outline-light px-4 py-2" style="border-radius: 50px;">Follow</button>
                    </div>
                </div>
            </div>
            <hr style="border-color: #282828; margin-bottom: 40px;">
            <h3 class="mb-4" style="font-weight: 600;">Songs by Travis Scott</h3>
            <table class="table table-dark table-hover mt-3" style="background-color: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid #282828;">
                        <th class="text-secondary pb-3">#</th>
                        <th class="text-secondary pb-3">Title</th>
                        <th class="text-secondary pb-3">Album</th>
                        <th class="text-secondary pb-3">Length</th>
                        <th class="text-secondary pb-3"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="pt-3">1</td>
                        <td class="pt-3" style="font-weight: 600; color: white;">goosebumps</td>
                        <td class="pt-3" style="color: #B3B3B3;">Birds In The Trap Sing McKnight</td>
                        <td class="pt-3" style="color: #B3B3B3;">4:04</td>
                        <td><button class="btn btn-sm btn-outline-light" style="border-radius: 50px;">Play</button></td>
                    </tr>
                    <tr>
                        <td class="pt-3">2</td>
                        <td class="pt-3" style="font-weight: 600; color: white;">SICKO MODE</td>
                        <td class="pt-3" style="color: #B3B3B3;">ASTROWORLD</td>
                        <td class="pt-3" style="color: #B3B3B3;">5:13</td>
                        <td><button class="btn btn-sm btn-outline-light" style="border-radius: 50px;">Play</button></td>
                    </tr>
                    <tr>
                        <td class="pt-3">3</td>
                        <td class="pt-3" style="font-weight: 600; color: white;">HYAENA</td>
                        <td class="pt-3" style="color: #B3B3B3;">UTOPIA</td>
                        <td class="pt-3" style="color: #B3B3B3;">3:42</td>
                        <td><button class="btn btn-sm btn-outline-light" style="border-radius: 50px;">Play</button></td>
                    </tr>
                </tbody>
            </table>
        </div>