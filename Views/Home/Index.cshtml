@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <h1 class="display-4 fw-bold mb-3">Welcome to Musicfy!</h1>
            <p class="lead text-secondary">Your personal music library manager. Organize your favorite artists, tracks,
                and playlists in one place.</p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Library" class="btn btn-musicfy px-4 py-2 me-2">Explore Library</a>
                    <a asp-controller="Songs" asp-action="Create" class="btn btn-outline-light px-4 py-2">Upload Track</a>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-md-4 mb-4">
                <a asp-controller="Songs" asp-action="Index" class="text-decoration-none">
                    <div class="card p-4 border-secondary bg-dark h-100 shadow-sm" style="transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform=''">
                        <h3 class="text-success fw-bold">@(ViewBag.TrackCount >= 10 ? ViewBag.TrackCount + "+" : ViewBag.TrackCount)</h3>
                        <p class="text-secondary mb-0">Tracks in your collection</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4 mb-4">
                <a asp-controller="Artists" asp-action="Index" class="text-decoration-none">
                    <div class="card p-4 border-secondary bg-dark h-100 shadow-sm" style="transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform=''">
                        <h3 class="text-success fw-bold">Artists</h3>
                        <p class="text-secondary mb-0">Verified profiles available</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card p-4 border-secondary bg-dark h-100 shadow-sm">
                    <h3 class="text-success fw-bold">Secure</h3>
                    <p class="text-secondary mb-0">Your library is saved forever</p>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <h4 class="mb-4 fw-bold">What's New</h4>
                <div class="list-group list-group-flush">
            
                    <div class="list-group-item bg-transparent border-secondary text-white px-0 py-3">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 text-success">Playlist Privacy & Management</h6>
                            <span class="badge bg-success rounded-pill">NEW</span>
                        </div>
                        <p class="mb-1 text-secondary small">
                            You can now set your playlists to private! Also, easily add songs to any of your playlists without ever leaving the Songs page, thanks to a streamlined dropdown menu.
                        </p>
                    </div>

                    <div class="list-group-item bg-transparent border-secondary text-white px-0 py-3">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 text-success">Instant Song Search Fixed</h6>
                            <small class="text-secondary">Updated</small>
                        </div>
                        <p class="mb-1 text-secondary small">
                            Our live search is back online! Looking for a specific track? Just type its name and the list updates instantly.
                        </p>
                    </div>

                    <div class="list-group-item bg-transparent border-secondary text-white px-0 py-3">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 text-success">Admin Verified Artists</h6>
                            <span class="badge bg-success rounded-pill">NEW</span>
                        </div>
                        <p class="mb-1 text-secondary small">
                            Authentic artist profiles now feature an official Verified Badge! Admins can manage verified statuses to keep the library trustworthy.
                        </p>
                    </div>

                </div>
            </div>
        </div>