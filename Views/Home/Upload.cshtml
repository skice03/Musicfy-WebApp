@{
    ViewData["Title"] = "Upload";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">Upload a new song to your library</h2>
            <form>
                <div class="mb-3">
                    <label class="form-label">Song Title</label>
                    <input type="text" class="form-control bg-dark text-white border-secondary">
                </div>
                <div class="mb-3">
                    <label class="form-label">Artist</label>
                    <input type="text" class="form-control bg-dark text-white border-secondary">
                </div>
                <div class="mb-3">
                    <label class="form-label">Audio File (.mp3)</label>
                    <input type="file" class="form-control bg-dark text-white border-secondary">
                </div>
                <button type="submit" class="btn btn-musicfy w-100 mt-3">Upload Track</button>
            </form>
        </div>
    </div>
</div>