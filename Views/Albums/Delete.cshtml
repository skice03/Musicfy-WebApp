@model MusicfyWebApp.Models.Album

@{
    ViewData["Title"] = "Deleting album";
}

<div class="container mt-4">
    <h1 class="text-danger">Delete the album</h1>
    <h3>Are you sure you want to delete this album?</h3>
    <p class="text-muted">Action cannot be undone.</p>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                Album Title
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Title)
            </dd>
            
            <dt class="col-sm-2">
                Release
            </dt>
            <dd class="col-sm-10">
                @Model.ReleaseYear
            </dd>
        </dl>
        
        @* send id to delete confirmed *@
        <form asp-action="Delete">
            <input type="hidden" asp-for="AlbumId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>