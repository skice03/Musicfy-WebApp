@model IEnumerable<MusicfyWebApp.Models.Album>
@{
    ViewData["Title"] = "Albums";
}

<div class="container mt-5 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Albums</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success fw-bold" style="border-radius: 50px; padding: 8px 24px;">+ Add album</a>
        }
    </div>

    <div class="row mt-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4 text-center">
                    <a asp-action="Details" asp-route-id="@item.AlbumId" class="text-decoration-none">
                        <div class="card bg-transparent border-0 shadow-hover p-3" style="transition: 0.3s;">
                            @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" class="rounded shadow mx-auto mb-3"
                                     style="width: 180px; height: 180px; object-fit: cover;" alt="@item.Title">
                            }
                            else
                            {
                                <div class="bg-secondary rounded shadow mx-auto mb-3 d-flex align-items-center justify-content-center"
                                     style="width: 180px; height: 180px;">
                                    <span class="fs-1 text-white-50">💿</span>
                                </div>
                            }
                            <h5 class="text-white fw-bold mb-1">@item.Title</h5>
                            <p class="text-secondary small mb-0">
                                @(item.Artist != null ? item.Artist.Name : "Unknown") &middot; @item.ReleaseYear
                            </p>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <h4 class="text-secondary">No albums yet</h4>
                <p class="text-secondary">Albums will appear here once added.</p>
            </div>
        }
    </div>
</div>

<style>
    .shadow-hover:hover {
        background-color: #282828 !important;
        border-radius: 10px;
        transform: translateY(-5px);
    }
</style>