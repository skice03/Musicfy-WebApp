@model MusicfyWebApp.Models.Album

@{
    ViewData["Title"] = "Album Details";
}

<div class="container mt-4">
    <h1>Album Details/h1>

        <div>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Title)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Title)
                </dd>
            
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ReleaseYear)
                </dt>
                <dd class="col-sm-10">
                    @Model.ReleaseYear.ToString("dd MMMM yyyy")
                </dd>

                <dt class="col-sm-2">
                    Artist
                </dt>
                <dd class="col-sm-10">
                    @(Model.Artist != null ? Model.Artist.Name : "No name")
                </dd>
            </dl>
        </div>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model?.AlbumId" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </div>
    </div>